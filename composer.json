{
    "name": "infrangible/m2-simple-mail",
    "description": "Lets Infrangible modules send plain emails, such as task reports, through the store's mail setup, and adds a test mail button to the admin.",
    "type": "magento2-module",
    "version": "2.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Email"
    ],
    "homepage": "https://www.infrangible.dev/modules/simple-mail",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-filter": "*",
        "fewedev/base": "~2.4.0",
        "infrangible/m2-core": "~5.0.1",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "magento/module-backend": "~102.0.0",
        "magento/module-config": "~101.2.0",
        "psr/log": "~2.0.0||~3.0.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\SimpleMail\\": "src"
        }
    }
}
